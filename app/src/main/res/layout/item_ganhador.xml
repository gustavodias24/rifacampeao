<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/boxContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/boxActions"
            android:layout_toLeftOf="@+id/boxActions"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loteria"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLoteria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Data"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Números"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNumeros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0000, 0000, 0000, 0000, 0000, 0000" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="Deletar"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="#DC2626" />

            <ImageButton
                android:id="@+id/btnImprimir"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="Compartilhar WhatsApp"
                android:padding="6dp"
                android:scaleType="fitXY"
                android:src="@drawable/print" />

            <ImageButton
                android:id="@+id/btnPdf"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="Gerar PDF"
                android:padding="6dp"
                android:scaleType="fitXY"
                android:src="@drawable/pdf" />

        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>